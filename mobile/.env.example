# Optional. In Expo Go the app finds the server by itself: port 3000 on the computer whose address is in the QR code
# (the one that runs Expo: npm run phones). Set this only when the server lives somewhere else. Expo reads it when it
# starts, so start Expo again after changing it. Just the computer's address means port 3000: 192.168.1.20 is
# http://192.168.1.20:3000.
#
# The installed Android app does not read this file: EAS Build never uploads it (.easignore). A default address for an
# installed app goes in eas.json's build profile ("env"), and the address typed on the phone wins over it. But
# `eas update` bundles the app on this computer and does read this file, so leave EXPO_PUBLIC_API_URL unset here when
# publishing an update.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Only for testing in a browser: 1 makes the web build ask for the server's address, as the installed Android app does.
# EXPO_PUBLIC_ASK_FOR_SERVER=1
