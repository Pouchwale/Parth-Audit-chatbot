# Copy to .env and fill in. .env is ignored by git.

# The app in Expo Go looks for this server on port 3000 of the computer that runs Expo (npm run phones): keep 3000.
PORT=3000
# The address the server listens on: 0.0.0.0 (every network card, the default) lets the phones on the Wi-Fi reach it.
# HOST=0.0.0.0

# Production: a Postgres URL. Leave empty in development to use the embedded database in ./.data/pglite.
DATABASE_URL=

# Encrypts the connected-system sign-ins stored for each session: 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# DCRS usernames (comma-separated) that can open the super admin view. With DCRS these are sign-in emails, such as
# the DCRS super admin's (admin@gpp.local on a newly seeded DCRS).
SUPER_ADMINS=

# Groq, which powers the assistant. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# How hard reasoning models (such as gpt-oss) think: low | medium | high. Lower is faster. Empty sends nothing.
GROQ_REASONING_EFFORT=medium
# Answers instead of GROQ_MODEL while Groq's limits keep that model busy for more than a moment (a 429 saying to wait
# more than 2 seconds). Each model has limits of its own on the free plan, so the fallback answers at once instead of
# the person waiting out the primary model's minute. Off when empty: the person is then shown the wait and the server
# waits it out (up to 30 seconds at a time, a minute a turn), or is asked to try again later. Suggested value:
# openai/gpt-oss-20b, the smaller model of the same family: faster, and it takes the same tool calls, but it reasons
# less well on a long request, and a fallback answer is not cached with the primary's prompt.
GROQ_FALLBACK_MODEL=
# Names new conversations (a reasoning model such as gpt-oss; it thinks with low effort).
GROQ_TITLE_MODEL=openai/gpt-oss-20b
# Turns voice recordings into text.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Describes the photos people attach, once each, so the chat model can read them as text. It must take images;
# qwen/qwen3.8-27b is the only Groq model that does. The free tier reads about 3 images a minute.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# The largest file a person can attach, in MB.
FILE_MAX_MB=20
# How much of the attached files' text the assistant is given in one request, in characters, across the whole
# conversation (newest message first). About four characters make a token: 16000 fits the free tier's 8,000 tokens a
# minute with room for the conversation itself. A paid tier can take far more.
FILE_TEXT_CHARS=16000
# How much of a conversation's earlier turns the model is given with each request, in characters. The turn being
# answered always goes in full; older turns go whole, newest first, while they fit, and the model is told when the
# start of the conversation was left out. 12000 (about 3,000 tokens) suits the free tier.
HISTORY_CHARS=12000

# Digital Controlled Record System (DCRS): the address of the DCRS server, which serves its app and its API on one
# port (API_PORT in DCRS's backend/.env; 4000 when unset). Use its address on the factory network, such as
# http://192.168.1.20:4000, or http://127.0.0.1:4000 when both run on one computer; not DCRS's development page server
# on port 5173. People sign in with their DCRS email and password, and every action runs with their own DCRS sign-in,
# so DCRS's departments, working hours and rules apply. DCRS ends each sign-in at the close of its day (6:20 pm for
# staff, midnight for the super admin), so the app asks everyone to sign in again each morning. DCRS writes every
# change in the record's history and its activity log as "Through Mitra mobile app".
DCRS_BASE_URL=

# Behind a reverse proxy or load balancer, set this so sign-ins log the real client IP:
# true (trust any proxy), a hop count, or the proxy addresses.
TRUST_PROXY=

# Browser origins allowed to call the API (comma-separated, or * for any). Only the web build needs this;
# the phone app doesn't. Demo mode allows any origin.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Weekly reports in the security dashboard run from Monday to Sunday in this IANA time zone (e.g. Asia/Kolkata).
# With DCRS, use the factory's: Asia/Kolkata.
REPORT_TIME_ZONE=UTC

# SESSION_TTL_DAYS=30
# CONFIRMATION_TTL_MINUTES=10
# Conversations are deleted this long after their last message. Download records and the action log are kept.
# CONVERSATION_RETENTION_DAYS=30
